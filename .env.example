HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://127.0.0.1:3100
DATA_DIR=.data
# 可选：对外展示的中转地址与兑换页地址（不影响 PUBLIC_ORIGIN 的登录校验），留空则使用 PUBLIC_ORIGIN。
RELAY_PUBLIC_URL=
REDEEM_PUBLIC_URL=
# HTTPS 反向代理部署时，设置正式 PUBLIC_ORIGIN 并启用安全 Cookie。
COOKIE_SECURE=false
# 官方地址默认 https://image.novelai.net；测试可使用本地 mock。
UPSTREAM_ORIGIN=https://image.novelai.net
